{
  "name": "@sleepless/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "post": "node --env-file=.env --import tsx src/post.ts",
    "counts": "node --env-file=.env --import tsx src/counts.ts",
    "authorize": "node --env-file=.env --import tsx src/authorize.ts",
    "refresh-token": "node --env-file=.env --import tsx src/refresh-token.ts",
    "tokens": "node --import tsx src/token-admin.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "credentials:check": "node --env-file=.env --import tsx src/credentials-check.ts",
    "check": "tsc --noEmit",
    "check:worker": "tsc --project tsconfig.worker.json",
    "check:test": "tsc --project tsconfig.test.json",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env=\"\"",
    "migrate:staging": "wrangler d1 migrations apply sleepless-bot-staging --remote --env staging",
    "migrate:production": "wrangler d1 migrations apply sleepless-bot --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@types/node": "^20.19.0",
    "miniflare": "5.20261012.1-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@xdevplatform/xdk": "^0.6.6"
  }
}
