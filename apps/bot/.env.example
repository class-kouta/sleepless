# OAuth 1.0a User Context: used only for posting as the Bot account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# App-only Bearer Token: used only for Recent Post Counts.
X_BEARER_TOKEN=

# OAuth 2.0 User Context: used for posting as the Bot account.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_OAUTH2_REDIRECT_URI=

# Cloudflare Worker secrets: set with `wrangler secret put`, never in this file.
# X_BEARER_TOKEN=
# TEST_POST_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET= (confidential clients only)
# TOKEN_ENCRYPTION_KEYS= (JSON object of key ID -> base64 32-byte key)
# OAUTH_ALERT_WEBHOOK_URL= (HTTPS JSON webhook; optional if external log alerts are configured)

# Local token-admin only. Use the same key ring/active ID as the target Worker.
# Keep the key ring in your password manager and provide it via an environment variable.
# TOKEN_ENCRYPTION_KEYS=
# TOKEN_ACTIVE_KEY_ID=v1
