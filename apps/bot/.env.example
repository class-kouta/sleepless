# OAuth 1.0a User Context: used only for posting as the Bot account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# App-only Bearer Token: used only for Recent Post Counts.
X_BEARER_TOKEN=

# OAuth 2.0 User Context: used for posting as the Bot account.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_OAUTH2_REDIRECT_URI=

# Cloudflare Worker staging only: set with `wrangler secret put`, never in this file.
# X_USER_ACCESS_TOKEN=
# TEST_POST_SECRET=
